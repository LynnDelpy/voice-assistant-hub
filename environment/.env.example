# Copy this file to `.env` (same directory) and fill in the value.
# `.env` is gitignored. Never commit a real key.
#
# Docker Compose reads `.env` automatically and passes VAHUB_LLM__API_KEY into
# the hub container, where the agent uses it for the OpenRouter LLM.

VAHUB_LLM__API_KEY=

# --- only needed for `./sandbox.sh real-ha` (your real Home Assistant) ---
HA_URL=https://ha.tramkompass.ch
# HA_TOKEN=your-long-lived-access-token   # create one in HA: profile -> Security
# HA_VERIFY_SSL=false   # only if your HA uses a self-signed HTTPS cert

# --- notifications (ntfy) ---
# What ntfy advertises as its own address. Set this to an address your PHONE can
# reach, otherwise the links it generates point at the wrong host.
# NTFY_BASE_URL=http://192.168.196.3:2586

# --- where the hub listens on the host ---
# Default is 0.0.0.0 (reachable from the LAN). The hub has no authentication of
# its own, so set this to 127.0.0.1 and use the mTLS proxy for remote access if
# the machine is on an untrusted network.
# HUB_BIND=127.0.0.1
