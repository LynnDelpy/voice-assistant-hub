# ============================================================================
#  vahub configuration  --  this is the ONE file you edit
# ============================================================================
#
#   cp .env.example .env      then edit .env  (.env is gitignored)
#
# Everything tunable lives here: secrets, URLs, ports, the model, budgets,
# toggles. You should not need to edit docker-compose.yml or any YAML to run
# this. Any VAHUB_* variable you add here reaches the hub, so anything in the
# config model can be set from this file even if it is not listed below.
#
# The only things NOT here are the ones that genuinely are not key=value. They
# live in ./config/ :
#   config/policy.yaml        which tools+arguments are allowed (the gate)
#   config/schedules.yaml     cron routines
#   config/modules.d/*.yaml   one manifest per module
#   config/homeassistant.yaml the simulated home's devices (demo mode only)
#
# Naming: VAHUB_* is read by the hub itself (VAHUB_WEB__PORT sets web.port,
# the double underscore is the nesting separator). Everything else configures
# the containers around it.
# ============================================================================

# ---------------------------------------------------------------- secrets --
# OpenRouter / OpenAI-compatible API key for the language model.
VAHUB_LLM__API_KEY=

# --------------------------------------------------------- language model --
# Any OpenAI-compatible endpoint: OpenRouter, OpenAI, Groq, Ollama, llama.cpp.
# Set VAHUB_LLM__PROVIDER=mock for a no-key keyword stub (offline testing).
VAHUB_LLM__PROVIDER=openai_compat
VAHUB_LLM__BASE_URL=https://openrouter.ai/api/v1
VAHUB_LLM__MODEL=deepseek/deepseek-v4-flash
VAHUB_LLM__TEMPERATURE=0.2
VAHUB_LLM__MAX_TOKENS=1024

# -------------------------------------------------------- home assistant --
# Used by `./vahub up --real-ha`. In plain `up` (demo mode) the hub talks
# to the simulated Home Assistant container instead and these are ignored.
# Use an IP or real DNS name, not a .local mDNS name.
HA_URL=
HA_TOKEN=
HA_VERIFY_SSL=true

# ---------------------------------------------------------- notifications --
# ntfy runs in the sandbox; no account needed. Pick an unguessable topic: by
# default anyone who knows it can read and post to it.
NOTIFY_BACKEND=ntfy
NTFY_TOPIC=vahub-alerts
NTFY_PORT=2586
# What ntfy advertises as its own address. Must be reachable BY YOUR PHONE,
# so "localhost" only works for testing on this machine.
NTFY_BASE_URL=http://localhost:2586
# Where the hub sends notifications. Default is the sandbox's own ntfy.
# NTFY_URL=http://ntfy:80
# For pushover instead of ntfy: NOTIFY_BACKEND=pushover
# PUSHOVER_TOKEN=
# PUSHOVER_USER=

# ------------------------------------------------------------------- web --
HUB_PORT=8080
# 0.0.0.0 = reachable from your LAN. The hub has NO authentication of its own,
# so on an untrusted network set 127.0.0.1 and use the mTLS proxy instead.
HUB_BIND=0.0.0.0
# Enables POST /api/dev/call, which runs tools directly with no agent. Handy
# for testing, but it is an unauthenticated remote-control endpoint: turn it
# off (false) if the port is reachable by anyone else.
VAHUB_WEB__DEV_TOOLS_ENDPOINT=true
# Browser origins allowed to call the API. JSON list. ["*"] disables the
# cross-origin check entirely; prefer listing exact origins.
VAHUB_WEB__ORIGIN_ALLOWLIST=["*"]

# --------------------------------------------------------------- general --
VAHUB_LOG_LEVEL=INFO
VAHUB_TIMEZONE=Europe/Zurich

# --------------------------------------------------------------- budgets --
# Guard rails per conversation turn (and per day for tokens).
VAHUB_BUDGETS__ITERATIONS_PER_TURN=8
# How much of a tool's output reaches the model. A real Home Assistant can
# return hundreds of entities, and anything past this limit is invisible to it.
VAHUB_BUDGETS__TOOL_RESULT_BYTES=16384
VAHUB_BUDGETS__TOKENS_PER_TURN=20000
VAHUB_BUDGETS__WALL_CLOCK_TEXT_S=30
VAHUB_BUDGETS__WALL_CLOCK_VOICE_S=8
# VAHUB_BUDGETS__TOKENS_PER_DAY=200000

# ----------------------------------------------------------- speech (M7) --
# mock = the browser does speech locally (no credentials). Set to
# openai_compat with a base_url/key for real server-side STT/TTS.
VAHUB_STT__PROVIDER=mock
VAHUB_TTS__PROVIDER=mock
# VAHUB_STT__API_KEY=
# VAHUB_TTS__API_KEY=

# --------------------------------------------------------------- proxy ----
# mTLS proxy port (only used by `./vahub up --tls`).
PROXY_PORT=8443
